# --- Required API keys ---
# Anthropic Claude is used for grounded answer synthesis (and the eval LLM-as-judge).
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI is used for embeddings (text-embedding-3-small) during ingestion + query.
OPENAI_API_KEY=sk-...

# --- Models (override if you like) ---
ANSWER_MODEL=claude-haiku-4-5
JUDGE_MODEL=claude-haiku-4-5
EMBED_MODEL=text-embedding-3-small
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Embedding provider: "openai" (default) or "fastembed" (local, offline) ---
EMBED_PROVIDER=openai
# Local fallback model used only when EMBED_PROVIDER=fastembed
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval knobs ---
VECTOR_TOP_K=20
BM25_TOP_K=20
RERANK_TOP_N=8
RERANK_ENABLED=true
RRF_K=60
MAX_CONTEXT_TOKENS=6000

# --- Chunking knobs ---
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=100

# --- Vision fallback: on a text abstention, retry with Claude vision over the top pages
# (recovers figure/chart answers; still abstains when the answer truly isn't there) ---
VISION_FALLBACK_ENABLED=true
VISION_FALLBACK_MAX_PAGES=2

# --- Paths ---
DATA_DIR=data
CHROMA_DIR=.chroma
